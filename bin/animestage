APP_STATE = os.path.join(STATE_DIR, "apps.json")
FF_BASES = [
    os.path.join(HOME, ".var", "app", "org.mozilla.firefox", "config", "mozilla", "firefox"),
    os.path.join(HOME, ".var", "app", "org.mozilla.firefox", ".mozilla", "firefox"),
    os.path.join(HOME, ".mozilla", "firefox"),
]
FF_PREF = 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
FF_PREF_MARK = "// AnimeStage: allows userChrome.css (removed again on uninstall)"
GEN_MARK = "/* AnimeStage – automatisch erzeugt, wird bei jedem Farbwechsel neu geschrieben */"
VSCODE_SETTINGS = [os.path.join(XDG_CONFIG, d, "User", "settings.json") for d in ("Code", "VSCodium", "Code - OSS")]


def apps_cfg(cfg):
    a = {"firefox": True, "vscode": True}
    a.update(cfg.get("apps") or {})
    return a


def theme_image(cfg):
    """Current wallpaper if safe, otherwise the anime's banner/cover."""
    cur = wall_state()["current"]
    if cur and os.path.isfile(cur) and is_safe(cur):
        return cur
    a = cfg.get("anime") or {}
    return a.get("banner") or a.get("cover") or ""


def darkened(src, dest, bg, amount, size=(1920, 1200), blur=0):
    """Image downscaled, slightly blurred and darkened with the background color."""
    from PIL import Image, ImageFilter
    im = Image.open(src).convert("RGB")
    im.thumbnail(size)
    if blur:
        im = im.filter(ImageFilter.GaussianBlur(blur))
    im = Image.blend(im, Image.new("RGB", im.size, tuple(hex2rgb(bg))), amount)
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    tmp = dest + ".tmp" + os.path.splitext(dest)[1]
    im.save(tmp, quality=88) if dest.endswith(".jpg") else im.save(tmp, optimize=True)
    os.replace(tmp, dest)
    return dest


# ---- Own images for terminal background and Firefox
# Every target has exactly one current image (cur-ID.jpg) and one prepared (next-ID.jpg).
# When the terminal/Firefox starts, the prepared one is promoted and a new one is
# downloaded in the background; old images are deleted right away. Always Konachan "safe" only.

THEMED_DIR = os.path.join(DATA_DIR, "themed")
THEMED_TARGETS = ("terminal", "firefox")
THEMED_FETCHING = ("anime", "animesuche", "suche")


def themed_cfg(cfg, target):
    if target == "firefox":
        f = {"source": "anime", "tags": "", "everyStart": True, "dim": 0.35, "ownColors": True}
        f.update(cfg.get("firefox") or {})
        return f
    t = cfg.get("terminal") or {}
    return {"source": t.get("bgSource", "anime") if t.get("bgImage", True) else "none",
            "tags": t.get("bgTags", ""), "everyStart": t.get("bgEveryStart", True)}


def search_tags(text):
    """„night sky, scenic“ → ["night_sky", "scenic"] (Komma trennt, Leerzeichen → _)."""
    tags = []
    for part in re.split(r"[,;\n]+", text or ""):
        tag = re.sub(r"\s+", "_", part.strip().lower())
        if tag and not re.match(r"-?(rating|order|limit|user|fav|vote|score)\:", tag) and tag not in tags:
            tags.append(tag)
    return tags[:3]


def resolve_tags(src, tags, timeout=15):
    """Map free input to real tags of the image source: "night_sky" doesn't exist on
    Konachan → "night" + "sky"; otherwise the most frequent tag containing the term."""
    cache_file = os.path.join(THEMED_DIR, f"tags-{src.name}.json")
    cache = load_json(cache_file, {})
    out = []

    def lookup(term):
        if term in cache:
            return cache[term]
        found = src.lookup(term, timeout)
        exact = next((n for n, c in found if n == term and c >= 5), None)
        # otherwise: most frequent tag containing the term as a whole word (not "lightsaber" for "lights")
        best = exact or next((n for n, c in sorted(found, key=lambda t: -t[1])
                              if c >= 20 and term in n.split("_")), None)
        res = [best] if best else []
        if not res and term.endswith("s") and len(term) > 4:
            res = lookup(term[:-1])
        if not res and "_" in term:
            res = [r for part in term.split("_") if len(part) > 2 for r in lookup(part)]
        cache[term] = res
        return res

    for tag in tags:
        neg = tag.startswith("-")
        for r in lookup(tag.lstrip("-")):
            r = ("-" + r) if neg else r
            if r not in out:
                out.append(r)
    os.makedirs(THEMED_DIR, exist_ok=True)
    write_atomic(cache_file, json.dumps(cache))
    return out[:3]


def themed_query(cfg, target):
    """(Konachan tags without character, character choice config) for a target."""
    tc = themed_cfg(cfg, target)
    scfg = term_wall_cfg(cfg) if target == "terminal" else dict(
        cfg, wallswitch=dict(wall_cfg(cfg), mood="", filter="strict" if wall_cfg(cfg)["filter"] == "strict" else "safe"))
    own = search_tags(tc["tags"]) if tc["source"] in ("animesuche", "suche") else []
    return own, scfg


def themed_sig(cfg, target):
    tc = themed_cfg(cfg, target)
    own, _scfg = themed_query(cfg, target)
    aid = (cfg.get("anime") or {}).get("id") if tc["source"] != "suche" else ""
    return f"{tc['source']}|{aid}|{' '.join(own)}|{wall_src(cfg).name}"


def themed_state(target):
    d = os.path.join(THEMED_DIR, target)
    return d, load_json(os.path.join(d, "state.json"), {})


def themed_save(target, st):
    d = os.path.join(THEMED_DIR, target)
    os.makedirs(d, exist_ok=True)
    st["seen"] = st.get("seen", [])[-300:]
    write_atomic(os.path.join(d, "state.json"), json.dumps(st))
    # delete everything that is neither current nor prepared
    keep = {(st.get(k) or {}).get("file") for k in ("cur", "next")}
    for n in os.listdir(d):
        p = os.path.join(d, n)
        if n.endswith(".jpg") and p not in keep:
            os.remove(p)


def themed_fetch(cfg, target, timeout=20):
    """Downloads a new image as "prepared" (next). Errors → exception with a readable message."""
    import random
    tc = themed_cfg(cfg, target)
    if tc["source"] not in THEMED_FETCHING:
        raise ValueError(_('Für dieses Ziel ist kein eigenes Bild eingestellt'))
    own, scfg = themed_query(cfg, target)
    a = cfg.get("anime") or {}
    if tc["source"] == "suche":
        if not own:
            raise ValueError(_('Keine Suchbegriffe eingetragen'))
        char, base = "all", []
    else:
        if not a.get("wallTag"):
            raise ValueError(_('Erst einen Anime wählen'))
        char = random.choice(wall_chars(scfg))
        base = [a["wallTag"] if char == "all" else char]
    src = wall_src(cfg)
    if own:
        own = resolve_tags(src, own)
        if not own:
            raise LookupError(_('Diese Suchbegriffe kennt {name} nicht – englische Begriffe probieren (z. B. night, sky, city)', name=src.name))
    d, st = themed_state(target)
    banned = set(map(str, wall_state()["banned"]))
    seen = set(st.get("seen", [])) | {str((st.get("cur") or {}).get("id"))}
    for other in THEMED_TARGETS:            # not the same image in terminal and Firefox
        ost = themed_state(other)[1]
        seen |= {str((ost.get(k) or {}).get("id")) for k in ("cur", "next")}
    w = dict(wall_cfg(scfg), minWidth=1600)
    posts = [p for p in src.search(base + own, rating="s", limit=100, random=True, timeout=timeout)
             if p["rating"] == "s" and post_ok(scfg, p, w, banned, char, ("s",))]
    if not posts:
        raise LookupError(_('Keine passenden Bilder gefunden – andere Suchbegriffe probieren'))
    post = next((p for p in posts if post_key(p) not in seen), posts[0])
    url = (post["large"] if target == "firefox" else post["sample"]) or post["url"]
    raw = sources.download(url, timeout)
    os.makedirs(d, exist_ok=True)
    pid = post_key(post)
    path = os.path.join(d, f"next-{pid}.jpg")
    write_atomic(path, raw, binary=True)
    d, st = themed_state(target)            # read again (parallel runs)
    st["next"] = {"sig": themed_sig(cfg, target), "id": pid, "file": path,
                  "tags": post["tags"], "author": post["author"], "site": src.name, "page": post["page"]}
    st.setdefault("seen", []).append(pid)
    themed_save(target, st)
    return path


def themed_take(cfg, target):
    """The prepared image becomes current. True if it switched."""
    d, st = themed_state(target)
    nxt = st.get("next") or {}
    if not nxt.get("file") or not os.path.isfile(nxt["file"]) or nxt.get("sig") != themed_sig(cfg, target):
        return False
    cur = os.path.join(d, f"cur-{nxt['id']}.jpg")
    os.replace(nxt["file"], cur)
    st["cur"] = dict(nxt, file=cur)
    st.pop("next", None)
    themed_save(target, st)
    return True


def themed_next_file(cfg, target):
    _d, st = themed_state(target)
    nxt = st.get("next") or {}
    ok = nxt.get("file") and os.path.isfile(nxt["file"]) and nxt.get("sig") == themed_sig(cfg, target)
    return nxt["file"] if ok else ""


def themed_current(cfg, target, fetch=True):
    """Image for the target matching the settings (downloads one if needed)."""
    tc = themed_cfg(cfg, target)
    if tc["source"] == "none":
        return ""
    if tc["source"] == "wallpaper":
        return theme_image(cfg)
    _d, st = themed_state(target)
    cur = st.get("cur") or {}
    if cur.get("file") and os.path.isfile(cur["file"]) and cur.get("sig") == themed_sig(cfg, target):
        return cur["file"]
    if themed_take(cfg, target):
        return themed_state(target)[1]["cur"]["file"]
    if fetch:
        try:
            themed_fetch(cfg, target, timeout=15)
            if themed_take(cfg, target):
                return themed_state(target)[1]["cur"]["file"]
        except Exception as exc:
            log(f"{target}-bild: {exc}")
    return theme_image(cfg)


def themed_lock(target):
    """Prevents two windows opened at the same time from downloading twice."""
    import fcntl
    os.makedirs(THEMED_DIR, exist_ok=True)
    fh = open(os.path.join(THEMED_DIR, f".{target}.lock"), "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fh.close()
        return None
    return fh


def themed_rotate(cfg, target):
    """Background run when the terminal or Firefox starts: prepare a new image for
    next time (terminal: promote and render right away)."""
    lock = themed_lock(target)
    if not lock:
        return
    try:
        if target == "terminal":
            if not themed_take(cfg, target):
                themed_fetch(cfg, target)
                themed_take(cfg, target)
            terminal_bg_image(cfg)
            themed_fetch(cfg, target)
        else:
            themed_fetch(cfg, target)
            prof = firefox_profile()
            if prof:
                firefox_render(cfg, prof, themed_next_file(cfg, target), nxt=True)
    except Exception as exc:
        log(f"{target}-wechsel: {exc}")
    finally:
        lock.close()


def themed_new(cfg, target):
    """"⟳ New image" in the Control Center: fetch a new image right away and apply it."""
    themed_fetch(cfg, target)
    themed_take(cfg, target)
    if target == "terminal":
        apply_konsole(cfg)             # open kitty windows reload the image immediately
        say(_('Neues Terminal-Bild (kitty sofort, Konsole im nächsten Fenster)'))
    else:
        apply_firefox(cfg, quiet=True)
        say(_("Neues Firefox-Bild – sichtbar nach Firefox-Neustart") if firefox_running() else _("Neues Firefox-Bild – beim nächsten Start"))
    spawn_bg(["themed-rotate", target] if target == "firefox" else ["themed-prefetch", target])


def themed_status(cfg):
    out = {}
    for target in THEMED_TARGETS:
        tc = themed_cfg(cfg, target)
        _d, st = themed_state(target)
        cur = st.get("cur") or {}
        valid = cur.get("file") and os.path.isfile(cur["file"]) and cur.get("sig") == themed_sig(cfg, target)
        img = cur["file"] if valid else (theme_image(cfg) if tc["source"] == "wallpaper" else "")
        out[target] = {"source": tc["source"], "image": img, "id": cur.get("id", "") if valid else "",
                       "author": cur.get("author", "") if valid else "",
                       "ready": bool(themed_next_file(cfg, target))}
    return out


def spawn_bg(args):
    subprocess.Popen([os.path.join(HOME, ".local", "bin", "animestage"), *args],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


# ---- Firefox

def firefox_profile():
    import configparser
    for base in FF_BASES:
        ini = os.path.join(base, "profiles.ini")
        if not os.path.exists(ini):
            continue
        cp = configparser.ConfigParser(strict=False, interpolation=None)
        cp.optionxform = str
        cp.read(ini, encoding="utf-8")
        path = ""
        for sec in cp.sections():           # default profile of this installation
            if sec.startswith("Install") and cp[sec].get("Default"):
                path = cp[sec]["Default"]
                break
        if not path:
            for sec in cp.sections():
                if sec.startswith("Profile") and cp[sec].get("Default") == "1":
                    path = cp[sec].get("Path", "")
        if not path:
            profs = [cp[s].get("Path", "") for s in cp.sections() if s.startswith("Profile")]
            path = profs[0] if profs else ""
        if path:
            full = path if os.path.isabs(path) else os.path.join(base, path)
            if os.path.isdir(full):
                return full
    return ""


def firefox_running():
    return subprocess.run(["pgrep", "-f", r"lib(64)?/firefox/firefox( |$)"], capture_output=True).returncode == 0


def ensure_import(css_file, name):
    line = f'@import "{name}";'
    text = open(css_file, encoding="utf-8").read() if os.path.exists(css_file) else ""
    if line not in text:
        write_atomic(css_file, line + "\n" + text)


def remove_import(css_file, name):
    if os.path.exists(css_file):
        text = open(css_file, encoding="utf-8").read().replace(f'@import "{name}";\n', "").replace(f'@import "{name}";', "")
        if text.strip():
            write_atomic(css_file, text)
        else:
            os.remove(css_file)


def rgba(col, a):
    r, g, b = hex2rgb(col)
    return f"rgba({r}, {g}, {b}, {a})"


FF_FILES = ("animestage-newtab.jpg", "animestage-chrome.css", "animestage-content.css")


def ff_name(name, nxt):
    base, ext = os.path.splitext(name)
    return f"{base}.next{ext}" if nxt else name


def firefox_render(cfg, prof, img, nxt=False):
    """Writes image + theme CSS. nxt=True: prepared version for the next start.
    With "colors from the image" the Firefox toolbar matches the own image."""
    fc = themed_cfg(cfg, "firefox")
    if nxt and not img:
        return
    pcfg = cfg
    if img and fc.get("ownColors", True) and fc["source"] in THEMED_FETCHING:
        try:
            pcfg = dict(cfg, colors=colors_from_image(img, cfg.get("colors")))
        except Exception as exc:
            log(f"firefox farben: {exc}")
    p = palette(pcfg)
    chrome = os.path.join(prof, "chrome")
    os.makedirs(chrome, exist_ok=True)
    has_img = False
    if img:
        try:
            darkened(img, os.path.join(chrome, ff_name("animestage-newtab.jpg", nxt)), p["bg"],
                     float(fc.get("dim", 0.35)), (2560, 1440))
            has_img = True
        except Exception as exc:
            log(f"firefox bild: {exc}")
    if not has_img and not nxt and os.path.exists(os.path.join(chrome, "animestage-newtab.jpg")):
        os.remove(os.path.join(chrome, "animestage-newtab.jpg"))
    bg, sf, sa, tx, mu, ac, a2, on = (p[k] for k in ("bg", "surface", "surfaceAlt", "text", "muted", "accent", "accent2", "onAccent"))
    write_atomic(os.path.join(chrome, ff_name("animestage-chrome.css", nxt)), f"""{GEN_MARK}
:root {{
  --lwt-accent-color: {bg} !important;
  --lwt-text-color: {tx} !important;
  --toolbar-bgcolor: {sf} !important;
  --toolbar-color: {tx} !important;
  --toolbar-field-background-color: {sa} !important;
  --toolbar-field-color: {tx} !important;
  --toolbar-field-focus-background-color: {sa} !important;
  --toolbar-field-focus-color: {tx} !important;
  --toolbar-field-focus-border-color: {ac} !important;
  --toolbarbutton-icon-fill-attention: {ac} !important;
  --tab-selected-bgcolor: {sa} !important;
  --tab-selected-textcolor: {tx} !important;
  --arrowpanel-background: {sf} !important;
  --arrowpanel-color: {tx} !important;
  --arrowpanel-border-color: {rgba(ac, 0.35)} !important;
  --focus-outline-color: {ac} !important;
  --urlbarView-highlight-background: {ac} !important;
  --urlbarView-highlight-color: {on} !important;
  --sidebar-background-color: {sf} !important;
  --sidebar-text-color: {tx} !important;
}}
#navigator-toolbox {{ background-color: {bg} !important; border-bottom: 1px solid {rgba(ac, 0.3)} !important; }}
.tab-background:is([selected], [multiselected]) {{ background: {sa} !important; box-shadow: inset 0 -2px 0 {ac} !important; }}
.tabbrowser-tab:hover .tab-background:not([selected]) {{ background: {rgba(tx, 0.06)} !important; }}
#urlbar[focused] > #urlbar-background {{ outline-color: {ac} !important; }}
""")
    newtab_bg = (f'linear-gradient({rgba(bg, 0.45)}, {rgba(bg, 0.8)}), url("animestage-newtab.jpg") center / cover fixed no-repeat'
                 if has_img else bg)
    write_atomic(os.path.join(chrome, ff_name("animestage-content.css", nxt)), f"""{GEN_MARK}
@-moz-document url("about:newtab"), url("about:home"), url("about:privatebrowsing") {{
  :root {{
    --newtab-background-color: {bg} !important;
    --newtab-background-color-secondary: {sf} !important;
    --newtab-text-primary-color: {tx} !important;
    --newtab-primary-action-background: {ac} !important;
  }}
  body {{ background: {newtab_bg} !important; }}
}}
""")


def apply_firefox(cfg, quiet=False):
    if not apps_cfg(cfg)["firefox"]:
        return
    prof = firefox_profile()
    if not prof:
        say(_('Firefox: kein Profil gefunden – übersprungen'))
        return
    fc = themed_cfg(cfg, "firefox")
    userjs = os.path.join(prof, "user.js")
    text = open(userjs, encoding="utf-8").read() if os.path.exists(userjs) else ""
    if FF_PREF not in text:
        write_atomic(userjs, text + ("\n" if text and not text.endswith("\n") else "") + FF_PREF_MARK + "\n" + FF_PREF + "\n")
    firefox_render(cfg, prof, themed_current(cfg, "firefox"))
    chrome = os.path.join(prof, "chrome")
    rotating = fc["everyStart"] and fc["source"] in THEMED_FETCHING
    nxt = themed_next_file(cfg, "firefox") if rotating else ""
    if nxt:
        firefox_render(cfg, prof, nxt, nxt=True)       # prepared image in the current colors
    else:
        for n in FF_FILES:
            if os.path.exists(os.path.join(chrome, ff_name(n, True))):
                os.remove(os.path.join(chrome, ff_name(n, True)))
    ensure_import(os.path.join(chrome, "userChrome.css"), "animestage-chrome.css")
    ensure_import(os.path.join(chrome, "userContent.css"), "animestage-content.css")
    firefox_launcher(rotating)
    if rotating and not nxt:
        spawn_bg(["themed-rotate", "firefox"])
    if not quiet:
        say(_('Firefox-Theme aktualisiert (sichtbar nach Firefox-Neustart)'))


# Launcher entry: open Firefox via `animestage firefox-start` – it swaps in
# the prepared image before starting (takes milliseconds) and then downloads
# the next one in the background.
FF_DESKTOP_SOURCES = [
    "/var/lib/flatpak/exports/share/applications/org.mozilla.firefox.desktop",
    os.path.join(XDG_DATA, "flatpak", "exports", "share", "applications", "org.mozilla.firefox.desktop"),
    "/usr/share/applications/org.mozilla.firefox.desktop",
    "/usr/share/applications/firefox.desktop",
]
FF_WRAP_MARK = "X-AnimeStage-Wrapper=true"


def firefox_launcher(on):
    changed = False
    sources = {}
    for src in FF_DESKTOP_SOURCES:          # first existing source per file name
        name = os.path.basename(src)
        if name not in sources or (not os.path.exists(sources[name]) and os.path.exists(src)):
            sources[name] = src
    for src in sources.values():
        dest = os.path.join(XDG_DATA, "applications", os.path.basename(src))
        ours = os.path.exists(dest) and FF_WRAP_MARK in open(dest, encoding="utf-8", errors="replace").read()
        if os.path.exists(dest) and not ours:
            continue                        # the user's own customization – don't touch
        if on and os.path.exists(src):
            bin_ = os.path.join(HOME, ".local", "bin", "animestage")
            lines = []
            for line in open(src, encoding="utf-8").read().splitlines():
                if line.startswith("Exec=") and "--ProfileManager" not in line:
                    line = f"Exec={bin_} firefox-start {line[5:]}"
                lines.append(line)
                if line == "[Desktop Entry]":
                    lines.append(FF_WRAP_MARK)
            text = "\n".join(lines) + "\n"
            if not ours or open(dest, encoding="utf-8").read() != text:
                write_atomic(dest, text)
                changed = True
        elif ours:
            os.remove(dest)
            changed = True
    if changed:
        run(["kbuildsycoca6"])


def firefox_start(argv):
    """Runs when Firefox is clicked: swap in the prepared image + matching colors,
    start Firefox, download the next image in the background."""
    try:
        cfg = load_config()
        i18n_setup(cfg)
        fc = themed_cfg(cfg, "firefox")
        if apps_cfg(cfg)["firefox"] and fc["everyStart"] and fc["source"] in THEMED_FETCHING and not firefox_running():
            prof = firefox_profile()
            chrome = os.path.join(prof, "chrome") if prof else ""
            pre = [os.path.join(chrome, ff_name(n, True)) for n in FF_FILES]
            if chrome and all(os.path.exists(p) for p in pre) and themed_take(cfg, "firefox"):
                for n in FF_FILES:
                    os.replace(os.path.join(chrome, ff_name(n, True)), os.path.join(chrome, n))
            spawn_bg(["themed-rotate", "firefox"])
    except Exception as exc:
        log(f"firefox-start: {exc}")
    if argv:
        os.execvp(argv[0], argv)


def firefox_off():
    firefox_launcher(False)
    prof = firefox_profile()
    if not prof:
        return
    userjs = os.path.join(prof, "user.js")
    if os.path.exists(userjs):
        text = open(userjs, encoding="utf-8").read()
        if FF_PREF_MARK in text:   # only if AnimeStage added the pref
            write_atomic(userjs, text.replace(FF_PREF_MARK + "\n" + FF_PREF + "\n", "").replace(FF_PREF_MARK + "\n", ""))
    chrome = os.path.join(prof, "chrome")
    remove_import(os.path.join(chrome, "userChrome.css"), "animestage-chrome.css")
    remove_import(os.path.join(chrome, "userContent.css"), "animestage-content.css")
    for n in FF_FILES:
        for nxt in (False, True):
            if os.path.exists(os.path.join(chrome, ff_name(n, nxt))):
                os.remove(os.path.join(chrome, ff_name(n, nxt)))
    say(_('Firefox-Theme entfernt (nach Firefox-Neustart)'))


# ---- VS Code

def vscode_colors(cfg):
    p = palette(cfg)
    t = term_colors(cfg)
    bg, sf, sa, tx, mu, ac, a2 = (p[k] for k in ("bg", "surface", "surfaceAlt", "text", "muted", "accent", "accent2"))

    def a(col, alpha):
        return col + format(int(alpha * 255), "02x")
    out = {
        "editor.background": bg, "editorGutter.background": bg,
        "editor.selectionBackground": a(ac, 0.28), "editor.lineHighlightBackground": a(tx, 0.04),
        "editorCursor.foreground": ac, "editorLineNumber.activeForeground": ac,
        "sideBar.background": sf, "sideBarSectionHeader.background": sf, "sideBar.border": a(ac, 0.15),
        "activityBar.background": bg, "activityBar.foreground": ac, "activityBar.activeBorder": ac,
        "activityBarBadge.background": a2, "activityBarBadge.foreground": p["onAccent2"],
        "titleBar.activeBackground": bg, "titleBar.inactiveBackground": bg, "titleBar.activeForeground": tx,
        "statusBar.background": sf, "statusBar.foreground": mu, "statusBar.border": a(ac, 0.25),
        "statusBarItem.remoteBackground": ac, "statusBarItem.remoteForeground": p["onAccent"],
        "editorGroupHeader.tabsBackground": sf, "tab.inactiveBackground": sf, "tab.activeBackground": bg,
        "tab.activeBorderTop": ac, "tab.border": sf,
        "panel.background": bg, "panel.border": a(ac, 0.2), "panelTitle.activeBorder": ac,
        "terminal.background": t["bg"], "terminal.foreground": t["fg"], "terminalCursor.foreground": t["cursor"],
        "focusBorder": a(ac, 0.6), "button.background": ac, "button.foreground": p["onAccent"],
        "progressBar.background": ac, "badge.background": a2, "badge.foreground": p["onAccent2"],
        "list.activeSelectionBackground": a(ac, 0.25), "list.inactiveSelectionBackground": a(ac, 0.12),
        "list.hoverBackground": a(tx, 0.05), "textLink.foreground": ac,
        "input.background": sa, "dropdown.background": sa, "editorWidget.background": sf,
        "quickInput.background": sf, "scrollbarSlider.background": a(mu, 0.2),
        "scrollbarSlider.hoverBackground": a(ac, 0.35),
    }
    names = ["Black", "Red", "Green", "Yellow", "Blue", "Magenta", "Cyan", "White"]
    for i, col in enumerate(t["ansi"]):
        out[f"terminal.ansi{'Bright' if i >= 8 else ''}{names[i % 8]}"] = col
    return out


def _vscode_files():
    return [f for f in VSCODE_SETTINGS if os.path.isdir(os.path.dirname(f))]


def apply_vscode(cfg, off=False):
    if not off and not apps_cfg(cfg)["vscode"]:
        return
    state = load_json(APP_STATE, {})
    managed = state.get("vscodeKeys", [])
    colors = {} if off else vscode_colors(cfg)
    done = 0
    for f in _vscode_files():
        try:
            data = load_json(f, None) if os.path.exists(f) else {}
            if data is None:
                say(_('VS Code: {f} enthält Kommentare/Fehler – nicht verändert', f=f))
                continue
            cc = dict(data.get("workbench.colorCustomizations") or {})
            for k in managed:            # only replace/remove our own entries
                cc.pop(k, None)
            cc.update(colors)
            if cc:
                data["workbench.colorCustomizations"] = cc
            else:
                data.pop("workbench.colorCustomizations", None)
            # images in the integrated terminal (for the greeting) – only remove if we set it
            if off:
                if state.get("vscodeImages"):
                    data.pop("terminal.integrated.enableImages", None)
            elif "terminal.integrated.enableImages" not in data:
                data["terminal.integrated.enableImages"] = True
                state["vscodeImages"] = True
            write_atomic(f, json.dumps(data, indent=4, ensure_ascii=False) + "\n")
            done += 1
        except Exception as exc:
            log(f"vscode {f}: {exc}")
    state["vscodeKeys"] = sorted(colors)
    if off:
        state.pop("vscodeImages", None)
    write_atomic(APP_STATE, json.dumps(state))
    if done:
        say(_("VS Code: Farben entfernt") if off else _("VS Code: Farben übernommen (sofort sichtbar)"))


def apps_toggle(cfg, app, on):
    cfg.setdefault("apps", {})[app] = on
    save_config(cfg)
    if app == "firefox":
        apply_firefox(cfg) if on else firefox_off()
    else:
        apply_vscode(cfg, off=not on)


# --------------------------------------------------------------------------
# Updates from GitHub
# --------------------------------------------------------------------------
# Releases on github.com/propanisen/AnimeStage carry the version as tag (v1.2.0).
# A daily systemd timer only *checks* and shows a notification; installing is
# always started by the user (Control Center or `animestage update install`).

UPDATE_REPO = "propanisen/AnimeStage"
UPDATE_STATE = os.path.join(STATE_DIR, "update.json")
UPDATE_UNITS = ("animestage-update.service", "animestage-update.timer")


def version_tuple(v):
    return tuple(int(x) for x in re.findall(r"\d+", str(v))[:3]) or (0,)


def installed_version():
    here = os.path.dirname(os.path.realpath(__file__))
    for path in (os.path.join(here, "..", "VERSION"), os.path.join(DATA_DIR, "VERSION")):
        if os.path.exists(path):
            return open(path, encoding="utf-8").read().strip()
    return "0"


def update_cfg(cfg):
    return {"check": True, "auto": False, **(cfg.get("updates") or {})}


def update_state():
    try:
        return json.load(open(UPDATE_STATE, encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def update_check(cfg):
    """Ask GitHub for the latest release. Returns the state dict (also saved)."""
    old = update_state()
    cur = installed_version()
    st = {"checked": int(time.time()), "current": cur, "notified": old.get("notified", "")}
    try:
        rel = http_json(f"https://api.github.com/repos/{UPDATE_REPO}/releases/latest", 20)
        st.update({"tag": rel["tag_name"], "latest": rel["tag_name"].lstrip("vV"),
                   "url": rel.get("html_url", ""), "notes": (rel.get("body") or "")[:2000]})
        st["available"] = version_tuple(st["latest"]) > version_tuple(cur)
    except urllib.error.HTTPError as exc:
        st.update({"available": False, "error": _("Noch keine Version auf GitHub veröffentlicht")
                   if exc.code == 404 else f"HTTP {exc.code}"})
    except Exception as exc:  # offline, DNS, rate limit …
        st.update({"available": False, "error": str(exc)[:200]})
    write_atomic(UPDATE_STATE, json.dumps(st, ensure_ascii=False))
    return st


def notify(title, body, actions=None):
    """Desktop notification; with actions it waits and returns the chosen action name."""
    if not shutil.which("notify-send"):
        return ""
    cmd = ["notify-send", "-a", "AnimeStage", "-i", "animestage", title, body]
    for name, label in (actions or {}).items():
        cmd[1:1] = ["-A", f"{name}={label}"]
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=6 * 3600 if actions else 30)
        return res.stdout.strip()
    except (subprocess.TimeoutExpired, OSError):
        return ""


def update_background(cfg):
    """Daily timer: check, then install automatically (setting) or offer an
    "Install now" button in a notification. Shown once per version."""
    st = update_check(cfg)
    if not st.get("available") or st.get("notified") == st["tag"]:
        return
    st["notified"] = st["tag"]
    write_atomic(UPDATE_STATE, json.dumps(st, ensure_ascii=False))
    if not update_cfg(cfg)["auto"]:
        choice = notify(_("AnimeStage-Update verfügbar"),
                        _("Version {version} – im Kontrollzentrum unter System installieren.", version=st["latest"]),
                        {"install": _("Jetzt installieren")})
        if choice != "install":
            return
    try:
        update_install(cfg)
        notify(_("AnimeStage aktualisiert"), _("Update installiert: {version}", version=st["latest"]))
    except SystemExit as exc:
        notify(_("AnimeStage-Update fehlgeschlagen"), str(exc.code or ""))
        raise


def update_install(cfg):
    st = update_check(cfg)
    if st.get("error"):
        sys.exit(_("Update-Prüfung fehlgeschlagen: {error}", error=st["error"]))
    if not st.get("available"):
        say(_("AnimeStage ist aktuell ({version})", version=st["current"]))
        return
    import io
    say(_("Lade AnimeStage {version} von GitHub", version=st["latest"]))
    raw = http_get(f"https://github.com/{UPDATE_REPO}/archive/refs/tags/{urllib.parse.quote(st['tag'])}.tar.gz", 300)
    dest = os.path.join(XDG_CACHE, "animestage", "update")
    shutil.rmtree(dest, ignore_errors=True)
    os.makedirs(dest)
    with tarfile.open(fileobj=io.BytesIO(raw), mode="r:gz") as tf:
        tf.extractall(dest, filter="data")
    dirs = [d for d in os.listdir(dest) if os.path.isfile(os.path.join(dest, d, "update.sh"))]
    if len(dirs) != 1:
        sys.exit(_("Update fehlgeschlagen – Details: {log}", log=LOG_FILE))
    src = os.path.join(dest, dirs[0])
    say(_("Installiere Update {version}", version=st["latest"]))
    # update.sh = install.sh --profile core --yes: selftest gate, backup, keeps all settings
    res = subprocess.run(["bash", os.path.join(src, "update.sh")], cwd=src)
    if res.returncode != 0:
        sys.exit(_("Update fehlgeschlagen – Details: {log}", log=LOG_FILE))
    shutil.rmtree(dest, ignore_errors=True)
    update_check(cfg)
    say(_("Update installiert: {version}", version=st["latest"]))


def update_timer(on):
    unit_dir = os.path.join(XDG_CONFIG, "systemd", "user")
    svc, tmr = (os.path.join(unit_dir, u) for u in UPDATE_UNITS)
    if on:
        write_atomic(svc, "\n".join([
            "[Unit]", "Description=AnimeStage: check GitHub for updates", "",
            "[Service]", "Type=oneshot",
            f"ExecStart={os.path.join(HOME, '.local', 'bin', 'animestage')} update check --notify",
            "TimeoutStartSec=infinity", "",
        ]))
        write_atomic(tmr, "\n".join([
            "[Unit]", "Description=AnimeStage: daily update check", "",
            "[Timer]", "OnCalendar=daily", "Persistent=true", "RandomizedDelaySec=1h", "",
            "[Install]", "WantedBy=timers.target", "",
        ]))
        run(["systemctl", "--user", "daemon-reload"])
        run(["systemctl", "--user", "enable", "--now", UPDATE_UNITS[1]])
    else:
        run(["systemctl", "--user", "disable", "--now", UPDATE_UNITS[1]])
        for path in (svc, tmr):
            if os.path.exists(path):
                os.remove(path)
        run(["systemctl", "--user", "daemon-reload"])


def uninstall_gui():
    """Start the graphical uninstaller from the installer copy (detached: it removes this program)."""
    script = os.path.join(DATA_DIR, "source", "install.sh")
    if not os.path.exists(script):
        sys.exit(_("Installer-Kopie fehlt – bitte ./uninstall.sh im heruntergeladenen Ordner starten"))
    subprocess.Popen(["bash", script, "--uninstall", "--gui"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, cwd=os.path.dirname(script))
    say(_("Deinstallation gestartet"))


def update_cmd(cfg, action, notify=False):
    if action == "status":
        st = update_state()
        st.update({"current": installed_version(), "check": update_cfg(cfg)["check"],
                   "auto": update_cfg(cfg)["auto"], "repo": UPDATE_REPO})
        if st.get("latest"):
            st["available"] = version_tuple(st["latest"]) > version_tuple(st["current"])
        print(json.dumps(st, ensure_ascii=False))
    elif action == "check" and notify:   # daily timer
        update_background(cfg)
    elif action == "check":
        st = update_check(cfg)
        if st.get("error"):
            sys.exit(_("Update-Prüfung fehlgeschlagen: {error}", error=st["error"]))
        if st["available"]:
            say(_("Neue Version verfügbar: {version} (installiert: {current})", version=st["latest"], current=st["current"]))
        else:
            say(_("AnimeStage ist aktuell ({version})", version=st["current"]))
    elif action == "install":
        update_install(cfg)
    elif action in ("on", "off"):
        cfg["updates"] = dict(update_cfg(cfg), check=action == "on")
        save_config(cfg)
        update_timer(action == "on")
        say(_("Automatische Update-Prüfung an (täglich)") if action == "on" else _("Automatische Update-Prüfung aus"))
    elif action in ("auto", "remind"):   # the three modes: auto / remind / off
        cfg["updates"] = dict(update_cfg(cfg), check=True, auto=action == "auto")
        save_config(cfg)
        update_timer(True)
        say(_("Updates werden automatisch installiert") if action == "auto" else _("Updates erst nach deinem Klick installieren"))
    elif action in ("auto-on", "auto-off"):
        cfg["updates"] = dict(update_cfg(cfg), auto=action == "auto-on")
        if action == "auto-on":
            cfg["updates"]["check"] = True
            update_timer(True)
        save_config(cfg)
        say(_("Updates werden automatisch installiert") if action == "auto-on" else _("Updates erst nach deinem Klick installieren"))
    elif action == "sync":            # installer: timer according to the config
        update_timer(update_cfg(cfg)["check"])
    elif action == "remove-timer":    # uninstaller: keep the setting, remove the timer
        update_timer(False)


# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------

APPLY_STEPS = {
    "colors": apply_colors,
    "style": apply_style,
    "deco": apply_deco,
    "konsole": apply_konsole,
    "kvantum": apply_kvantum,
    "font": apply_font,
    "wallpaper": apply_wallpaper,
    "lock": apply_lock,
    "splash": apply_splash,
    "icons": apply_icons,
    "firefox": apply_firefox,
    "vscode": apply_vscode,
    "rules": apply_window_rule,
    "taskbar": apply_taskbar,
}
APPLY_ALL = ["colors", "style", "icons", "deco", "konsole", "kvantum", "font", "wallpaper", "lock", "splash", "firefox", "vscode", "rules", "taskbar"]


def cmd_apply(cfg, parts):
    steps = APPLY_ALL if not parts or "all" in parts else parts
    for step in steps:
        fn = APPLY_STEPS.get(step)
        if not fn:
            say(_('unbekannter Schritt: {step}', step=step))
            continue
        try:
            fn(cfg)
        except Exception as exc:
            say(_('{step}: Fehler – {exc}', step=step, exc=exc))


def status(cfg):
    def mark(ok):
        return "✓" if ok else "·"
    scheme = run(["kreadconfig6", "--file", "kdeglobals", "--group", "General", "--key", "ColorScheme"])
    theme = run(["kreadconfig6", "--file", "plasmarc", "--group", "Theme", "--key", "name"])
    plasmoids = os.path.join(XDG_DATA, "plasma", "plasmoids")
    widgets = sorted(n for n in os.listdir(plasmoids) if n.startswith("org.animestage.")) if os.path.isdir(plasmoids) else []
    a = cfg.get("anime") or {}
    labels = ["Anime", _("Akzent"), _("Farbschema"), _("Plasma-Stil"), "Widgets", _("Wechsel"), _("Anmeldung"), "Backups"]
    width = max(len(x) for x in labels) + 2

    def row(ok, label, value):
        print(f"{mark(ok) if ok is not None else ' '} {label:<{width}}{value}")
    print(f"  {'Anime':<{width}}{a.get('title') or _('– noch keiner –')}  ({_('{n} Figuren', n=len(a.get('characters', [])))})")
    row(None, _("Akzent"), f"{cfg['colors']['accent']}  /  {cfg['colors']['accent2']}")
    row(scheme and scheme.stdout.strip() == THEME_NAME, _("Farbschema"), scheme.stdout.strip() if scheme else "?")
    row(theme and theme.stdout.strip() == THEME_NAME, _("Plasma-Stil"), theme.stdout.strip() if theme else "?")
    row(len(widgets) >= 5, "Widgets", f"{len(widgets)}: {', '.join(w.split('.')[-1] for w in widgets)}")
    row(wall_cfg(cfg)['enabled'], _("Wechsel"), _("alle {minutes} Min., Filter {filter}", minutes=wall_cfg(cfg)['minutes'], filter=wall_cfg(cfg)['filter']))
    row(login_ready(), _("Anmeldung"), "")
    row(None, "Backups", ", ".join(list_backups()) or "–")


def source_cmd(cfg, action, purpose="", name=""):
    """Show, check and switch image sources. On a switch the current anime's tags
    are looked up again on the new source (every site names things differently)."""
    cur = dict(sources.DEFAULTS, **(cfg.get("sources") or {}))
    if action == "list":
        print(json.dumps({"current": {k: sources.for_purpose(v, k).name for k, v in cur.items()},
                          "options": sources.listing()}, ensure_ascii=False))
        return
    if action == "check":
        names = [purpose] if purpose in sources.SOURCES else sorted({sources.for_purpose(v, k).name for k, v in cur.items()})
        bad = 0
        for n in names:
            ok, msg = sources.check(n)
            detail = _("{n} Bilder gefunden", n=msg) if ok else msg
            print(f"{'✓' if ok else '✗'} {n}: {_('erreichbar') if ok else _('nicht erreichbar')} ({detail})")
            bad += not ok
        if bad:
            sys.exit(1)
        return
    if purpose not in sources.PURPOSES or name not in sources.PURPOSES[purpose]:
        sys.exit(_("Mögliche Quellen: {list}", list=", ".join(
            f"{p}: {'/'.join(n)}" for p, n in sources.PURPOSES.items())))
    ok, msg = sources.check(name)
    if not ok:
        sys.exit(_('{name} ist gerade nicht erreichbar ({msg}) – Quelle nicht gewechselt', name=name, msg=msg))
    cfg.setdefault("sources", {})[purpose] = name
    save_config(cfg)
    a = cfg.get("anime") or {}
    if a.get("id") and (a.get("tagSites") or {}).get(purpose) != name:
        say(_("Suche {title} bei {site} …", title=a.get('title'), site=name))
        cfg = anime_set(cfg, a["id"], quiet=True)
        a = cfg["anime"]
        found = a.get("wallTag") if purpose == "wallpaper" else a.get("cutTag")
        if not found:
            say(_('⚠ {name} kennt diesen Anime nicht – dort gibt es keine passenden Bilder', name=name))
        elif purpose == "wallpaper":
            say("  " + _("{n} Figuren gefunden", n=len(a.get('characters', []))))
            if wall_cfg(cfg)["enabled"]:
                wall_next(cfg, quiet=True)
    say("✓ " + (_("Bildquelle für Hintergründe: {label}", label=sources.get(name).label) if purpose == "wallpaper"
                else _("Bildquelle für Freisteller: {label}", label=sources.get(name).label)))


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["firefox-start"]:          # from the Firefox launcher, rest = Firefox command
        firefox_start(argv[1:])
        return
    ap = argparse.ArgumentParser(prog="animestage", description="AnimeStage – control the anime theme for KDE Plasma")
    ap.add_argument("--version", action="version", version=f"AnimeStage {installed_version()}")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("init", help="create the config (if missing)")
    g = sub.add_parser("get", help="read the config")
    g.add_argument("path", nargs="?", default="")
    s = sub.add_parser("set", help="set a value, e.g. set colors.accent '#39C5BB'")
    s.add_argument("path")
    s.add_argument("value")
    s.add_argument("--apply", nargs="*", help="apply these steps afterwards")
    se = sub.add_parser("search", help="search anime on AniList (JSON)")
    se.add_argument("text", nargs="+")
    an = sub.add_parser("anime", help="use an anime: anime ANILIST-ID [--apply]")
    an.add_argument("id")
    an.add_argument("--apply", action="store_true", help="apply the theme and fetch a new wallpaper")
    ch = sub.add_parser("adult", help="mark a character without age as adult: adult CHARACTER-ID on|off")
    ch.add_argument("char_id", type=int)
    ch.add_argument("state", choices=["on", "off"])
    cu = sub.add_parser("cuts", help="download more cutouts (characters without background)")
    cu.add_argument("count", nargs="?", type=int, default=6)
    sub.add_parser("colors-from-wallpaper", help="take colors once from the current wallpaper")
    a = sub.add_parser("apply", help="apply theme parts: " + ", ".join(APPLY_ALL))
    a.add_argument("parts", nargs="*")
    ad = sub.add_parser("use-image", help="use your own image for a slot")
    ad.add_argument("file")
    ad.add_argument("slot", choices=["launcher", "splash"])
    im = sub.add_parser("images", help="list images for launcher/splash")
    im.add_argument("--json", action="store_true")
    fo = sub.add_parser("add-folder", help="add your own image folder")
    fo.add_argument("folder")
    fr = sub.add_parser("remove-folder", help="remove your own image folder")
    fr.add_argument("folder")
    sub.add_parser("fonts", help="install M PLUS Rounded 1c")
    sub.add_parser("backup", help="back up the current KDE settings")
    rs = sub.add_parser("restore", help="restore a backup (default: original)")
    rs.add_argument("name", nargs="?", default="original")
    sub.add_parser("backups", help="list backups")
    sub.add_parser("layout", help="set up the AnimeStage panel and desktop widgets (with backup)")
    sub.add_parser("layout-script", help="only print the layout script")
    sub.add_parser("status", help="installation status")
    sub.add_parser("migrate", help="migrate settings/panel from the previous version VocaStage")
    sub.add_parser("selftest", help="check the minor-protection rules")
    sub.add_parser("unrule", help=argparse.SUPPRESS)
    ap_ = sub.add_parser("apps", help="Firefox/VS Code in the theme colors: apps firefox|vscode on|off")
    ap_.add_argument("app", choices=["firefox", "vscode"])
    ap_.add_argument("state", choices=["on", "off"])
    t = sub.add_parser("terminal", help="terminal package: greeting, prompt, aliases (on/off)")
    t.add_argument("state", choices=["on", "off", "kitty", "konsole"],
                   help="on/off: greeting+prompt; kitty/konsole: default terminal (kitty is installed if needed)")
    t.add_argument("--tools", action="store_true", help="install starship, eza, bat, zoxide + kitty")
    sub.add_parser("greet", help="show the greeting with image and system info")
    th = sub.add_parser("themed", help="own images for terminal background/Firefox: themed new|status [terminal|firefox]")
    th.add_argument("action", choices=["new", "status"])
    th.add_argument("target", nargs="?", choices=list(THEMED_TARGETS), default="terminal")
    th.add_argument("--tags", default=None, help="set new search terms (own search)")
    for name in ("themed-rotate", "themed-prefetch"):
        sub.add_parser(name, help=argparse.SUPPRESS).add_argument("target", choices=list(THEMED_TARGETS))
    tf = sub.add_parser("term-fetch", help=argparse.SUPPRESS)
    tf.add_argument("stamp")
    lg = sub.add_parser("login", help="wallpaper on the login screen too (password once)")
    lg.add_argument("action", choices=["setup", "remove", "status"])
    ge = sub.add_parser("gender", help="characters: female only (female) or all (all) – looks up the characters again")
    ge.add_argument("value", choices=["female", "all"])
    so = sub.add_parser("source", help="image sources: source list | check [SOURCE] | set wallpaper|cutouts SOURCE")
    so.add_argument("action", choices=["list", "check", "set"])
    so.add_argument("purpose", nargs="?", default="")
    so.add_argument("name", nargs="?", default="")
    sub.add_parser("uninstall", help="graphical uninstaller (restores your KDE settings)")
    up = sub.add_parser("update", help="updates from GitHub: update status|check|install|auto|remind|off")
    up.add_argument("action", choices=["status", "check", "install", "auto", "remind", "off",
                                       "on", "auto-on", "auto-off", "sync", "remove-timer"])
    up.add_argument("--notify", action="store_true", help="desktop notification if a new version exists")
    wl = sub.add_parser("wall", help="rotating wallpapers (source configurable, default Konachan)")
    wl.add_argument("action", choices=["next", "fav", "ban", "fetch", "on", "off", "set", "list", "status", "open-favorites"])
    wl.add_argument("arg", nargs="?", default="", help="fetch: count, set: image file")
    wl.add_argument("--quiet", action="store_true")
    wl.add_argument("--safe", action="store_true", help=argparse.SUPPRESS)
    args = ap.parse_args(argv)

    cfg = load_config()
    i18n_setup(cfg)
    if args.cmd == "init":
        if not os.path.exists(CONFIG_FILE):
            save_config(cfg)
            say(_('Config angelegt: {path}', path=CONFIG_FILE))
    elif args.cmd == "get":
        val = get_path(cfg, args.path) if args.path else cfg
        print(json.dumps(val, indent=2, ensure_ascii=False) if isinstance(val, (dict, list)) else ("" if val is None else val))
    elif args.cmd == "set":
        value = parse_value(args.value)
        if args.path.startswith("colors."):
            value = rgb2hex(hex2rgb(value))
        set_path(cfg, args.path, value)
        save_config(cfg)
        # new interval → rewrite the timer
        if args.path == "wallswitch.minutes" and wall_cfg(cfg)["enabled"]:
            wall_timer(cfg, True)
        if args.apply is not None:
            cmd_apply(cfg, args.apply)
    elif args.cmd == "search":
        print(json.dumps(anime_search(" ".join(args.text)), ensure_ascii=False))
    elif args.cmd == "anime":
        cfg = anime_set(cfg, args.id)
        if args.apply:
            if wall_cfg(cfg)["enabled"] or not wall_state()["current"]:
                wall_next(cfg, quiet=True)
            else:
                auto_colors(cfg, image_or_default(cfg, "wallpaper"))
            cfg = load_config()
            cmd_apply(cfg, ["colors", "konsole", "lock", "splash"])
            say("✓ " + _("{title} ist aktiv", title=cfg['anime']['title']))
    elif args.cmd == "adult":
        for c in anime_chars(cfg):
            if c["id"] == args.char_id:
                if not char_lockable(c):
                    sys.exit(_("{name}: laut AniList {age} – lässt sich nicht freischalten", name=c['name'], age=c['age']))
                c["markedAdult"] = args.state == "on"
                save_config(cfg)
                say(f"{c['name']}: " + (_("volljährig") if c['markedAdult'] else _("nicht freigeschaltet")))
                break
        else:
            sys.exit(_('Figur nicht gefunden'))
    elif args.cmd == "cuts":
        say(_('{count} neue Freisteller', count=fetch_cuts(cfg, args.count)))
    elif args.cmd == "colors-from-wallpaper":
        cfg.setdefault("theme", {})["autoColors"] = True
        auto_colors(cfg, image_or_default(cfg, "wallpaper"))
        say(_('Farben aus dem Hintergrund übernommen'))
    elif args.cmd == "apply":
        cmd_apply(cfg, args.parts)
    elif args.cmd == "use-image":
        src = os.path.abspath(os.path.expanduser(args.file.replace("file://", "")))
        if not os.path.isfile(src):
            sys.exit(_('Bild nicht gefunden: {src}', src=src))
        cfg["images"][args.slot] = src
        save_config(cfg)
        if args.slot == "splash":
            apply_splash(cfg)
    elif args.cmd in ("add-folder", "remove-folder"):
        folder = os.path.abspath(os.path.expanduser(args.folder.replace("file://", "")))
        folders = [f for f in cfg.get("folders") or [] if f != folder]
        if args.cmd == "add-folder":
            if not os.path.isdir(folder):
                sys.exit(_('Ordner nicht gefunden: {folder}', folder=folder))
            folders.append(folder)
        cfg["folders"] = folders
        save_config(cfg)
        n = len(folder_images(cfg))
        say(_('{folders} eigene Ordner, {n} Bilder', folders=len(folders), n=n))
    elif args.cmd == "images":
        items = list_images(cfg) + folder_images(cfg)
        if args.json:
            print(json.dumps(items, ensure_ascii=False))
        else:
            for it in items:
                print(f"{it['source']:11} {it['artist'][:24]:24} {it['path']}")
    elif args.cmd == "fonts":
        install_fonts()
    elif args.cmd == "backup":
        backup()
    elif args.cmd == "restore":
        restore(args.name)
    elif args.cmd == "backups":
        print("\n".join(list_backups()))
    elif args.cmd == "layout":
        sys.exit(0 if apply_layout(cfg) else 1)
    elif args.cmd == "layout-script":
        print(layout_script(cfg))
    elif args.cmd == "status":
        status(cfg)
    elif args.cmd == "unrule":
        remove_window_rule()
    elif args.cmd == "selftest":
        fails = safety_selftest()
        for f in fails:
            print("✗ " + f)
        if fails:
            sys.exit(1)
        print("✓ " + _("Schutzregeln in Ordnung"))
    elif args.cmd == "apps":
        apps_toggle(cfg, args.app, args.state == "on")
    elif args.cmd == "migrate":
        if not migrate_vocastage():
            say(_('Keine VocaStage-Installation gefunden'))
    elif args.cmd == "terminal":
        if args.state in ("kitty", "konsole"):
            if args.state == "kitty" and not os.path.exists(os.path.join(KITTY_DIR, "bin", "kitty")):
                install_kitty()
            write_kitty_conf(cfg)
            set_default_terminal(args.state)
            cfg.setdefault("terminal", {})["app"] = args.state
            save_config(cfg)
            return
        cfg.setdefault("terminal", {})["enabled"] = args.state == "on"
        save_config(cfg)
        if args.state == "on":
            apply_konsole(cfg)
            terminal_on(cfg, args.tools)
        else:
            terminal_off()
    elif args.cmd == "greet":
        greet(cfg)
    elif args.cmd == "gender":
        cfg.setdefault("characters", {})["gender"] = args.value
        save_config(cfg)
        a = cfg.get("anime") or {}
        if a.get("id"):
            say(_("Suche Figuren von {title} neu …", title=a.get('title')))
            cfg = anime_set(cfg, a["id"], quiet=True)
        n = len(anime_chars(cfg))
        say("✓ " + (_("Nur weibliche Figuren – {n} gefunden", n=n) if args.value == "female" else _("Alle Figuren – {n} gefunden", n=n)))
    elif args.cmd == "source":
        source_cmd(cfg, args.action, args.purpose, args.name)
    elif args.cmd == "uninstall":
        uninstall_gui()
    elif args.cmd == "update":
        update_cmd(cfg, args.action, args.notify)
    elif args.cmd == "themed":
        if args.action == "status":
            print(json.dumps(themed_status(cfg), ensure_ascii=False))
        else:
            try:
                if args.tags is not None:
                    key = ("terminal", "bgTags") if args.target == "terminal" else ("firefox", "tags")
                    cfg.setdefault(key[0], {})[key[1]] = args.tags
                    if not search_tags(args.tags):
                        raise ValueError(_('Keine Suchbegriffe eingetragen'))
                    save_config(cfg)
                themed_new(cfg, args.target)
            except Exception as exc:
                sys.exit(str(exc))
    elif args.cmd == "themed-rotate":
        themed_rotate(cfg, args.target)
    elif args.cmd == "themed-prefetch":
        lock = themed_lock(args.target)
        if lock:
            try:
                themed_fetch(cfg, args.target)
            except Exception as exc:
                log(f"{args.target}-vorladen: {exc}")
    elif args.cmd == "term-fetch":
        path = term_fetch_now(cfg)
        if path:
            write_atomic(args.stamp, path)
    elif args.cmd == "login":
        if args.action == "status":
            print((_("veraltet – bitte neu einrichten") if login_outdated() else _("aktiv")) if login_ready() else _("nicht eingerichtet"))
        else:
            login_setup(args.action == "remove")
    elif args.cmd == "wall":
        if args.action == "next":
            sys.exit(0 if wall_next(cfg, args.quiet) else 1)
        elif args.action == "fav":
            wall_fav(cfg)
        elif args.action == "ban":
            wall_ban(cfg)
        elif args.action == "fetch":
            n = wall_fetch(term_wall_cfg(cfg) if args.safe else cfg, int(args.arg or 6), quiet=args.quiet)
            if not args.quiet:
                say(_('{n} neue Bilder geladen', n=n))
        elif args.action == "set":
            if not args.arg:
                sys.exit(_('animestage wall set BILDDATEI'))
            wall_set(cfg, args.arg)
        elif args.action == "list":
            print(json.dumps(wall_list(cfg), ensure_ascii=False))
        elif args.action in ("on", "off"):
            cfg["wallswitch"] = wall_cfg(cfg)
            cfg["wallswitch"]["enabled"] = args.action == "on"
            save_config(cfg)
            wall_timer(cfg, args.action == "on")
            if args.action == "on":
                wall_next(cfg)
        elif args.action == "status":
            print(json.dumps(wall_status(cfg), ensure_ascii=False))
        elif args.action == "open-favorites":
            os.makedirs(favorites_dir(), exist_ok=True)
            subprocess.Popen(["xdg-open", favorites_dir()], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    main()
