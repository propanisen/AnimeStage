def find_share():
    here = os.path.dirname(os.path.realpath(__file__))
    for cand in (os.path.join(here, "..", "share"), DATA_DIR):
        if os.path.isdir(os.path.join(cand, "logos")):
            return os.path.realpath(cand)
    sys.exit(_('animestage: Daten nicht gefunden – ist das Theme installiert?'))


SHARE = find_share()


def log(msg):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(LOG_FILE, "a", encoding="utf-8") as fh:
        fh.write(f"{datetime.datetime.now():%Y-%m-%d %H:%M:%S} {msg}\n")


def say(msg):
    print(msg, flush=True)
    log(msg)


def run(cmd, check=False, quiet=True):
    try:
        res = subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        log(f"fehlt: {cmd[0]}")
        return None
    if res.returncode != 0:
        log(f"{' '.join(cmd)} -> {res.returncode}: {res.stderr.strip()[:300]}")
        if check:
            raise SystemExit(res.stderr)
    elif not quiet:
        print(res.stdout, end="")
    return res


def qdbus():
    """Name of the qdbus program – Fedora/Bazzite only ship qdbus-qt6."""
    for name in ("qdbus6", "qdbus-qt6", "qdbus"):
        if shutil.which(name):
            return name
    return "qdbus"


def have(cmd):
    return shutil.which(cmd) is not None


def write_atomic(path, text, binary=False):
    path = os.path.abspath(path)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp{os.getpid()}"
    with open(tmp, "wb" if binary else "w", **({} if binary else {"encoding": "utf-8"})) as fh:
        fh.write(text)
    os.replace(tmp, path)


FIXED_COLORS = {"positive": "#5BE0A0", "neutral": "#F5C35B", "negative": "#FF5C7A"}
DEFAULT_COLORS = {"accent": "#4FC3D9", "accent2": "#E0568E", "bg": "#0C1115", "surface": "#121A20",
                  "surfaceAlt": "#1B252D", "text": "#ECF3F6", "muted": "#93A4AD", **FIXED_COLORS}


